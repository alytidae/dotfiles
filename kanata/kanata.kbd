(defcfg
  process-unmapped-keys yes
)

(defsrc
  q caps a s d f h j k l ; u o spc
)

(defvar
  tap-time 150
  hold-time 180
)

(defalias
  a (tap-hold-release $tap-time $hold-time a lalt)
  s (tap-hold-release $tap-time $hold-time s lmet)
  d (tap-hold-release $tap-time $hold-time d lsft)
  f (tap-hold-release $tap-time $hold-time f lctrl)
  j (tap-hold-release $tap-time $hold-time j rctrl)
  k (tap-hold-release $tap-time $hold-time k rsft)
  l (tap-hold-release $tap-time $hold-time l rmet)

  cap (tap-hold $tap-time $hold-time caps (layer-toggle nav))
)

(deflayer base
  q @cap @a @s @d @f h @j @k @l ; u o spc
)

(deflayer nav
  esc  _    _    _    _    _    left down up   right ret  home end  bspc
)
