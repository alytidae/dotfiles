(defcfg
  process-unmapped-keys yes
)

(defsrc
  caps a s d f h j k l ; spc
)

(defvar
  tap-time 150
  hold-time 200
)

(defalias
  a (tap-hold $tap-time $hold-time a lalt)
  s (tap-hold $tap-time $hold-time s lmet)
  d (tap-hold $tap-time $hold-time d lsft)
  f (tap-hold $tap-time $hold-time f lctrl)
  j (tap-hold $tap-time $hold-time j rctrl)
  k (tap-hold $tap-time $hold-time k rsft)
  l (tap-hold $tap-time $hold-time l rmet)
  ; (tap-hold $tap-time $hold-time ; ralt)
  
  cap (tap-hold 200 200 caps (layer-toggle extend))
)

(deflayer base
  @cap @a @s @d @f h @j @k @l @; spc
)

(deflayer extend
  _    _  _  _  _  left down up rght ret bspc
)
